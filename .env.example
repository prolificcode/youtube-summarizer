# YouTube Summarizer Configuration
# Copy this file to .env and customize the values as needed.
# All environment variables are prefixed with YTS_

# ============================================================================
# Ollama Configuration
# ============================================================================

# URL of the Ollama API server
# Default: http://localhost:11434
YTS_OLLAMA_HOST=http://localhost:11434

# Default Ollama model to use for summarization
# Popular options: llama3.1:8b, llama3.1:70b, mistral, mixtral
# Default: llama3.1:8b
YTS_DEFAULT_MODEL=llama3.1:8b

# Timeout for Ollama API requests in seconds (1-3600)
# Default: 300
YTS_API_TIMEOUT=300

# ============================================================================
# Database Configuration
# ============================================================================

# Path to SQLite database file
# Can be relative or absolute path
# Default: ~/.local/share/youtube-summarizer/summaries.db
YTS_DATABASE_PATH=~/.local/share/youtube-summarizer/summaries.db

# ============================================================================
# Summarization Settings
# ============================================================================

# Maximum tokens to generate for summaries (50-4096)
# Higher values = longer, more detailed summaries
# Default: 500
YTS_SUMMARY_MAX_LENGTH=500

# Temperature parameter for LLM generation (0.0-2.0)
# Lower values = more focused and deterministic
# Higher values = more creative and varied
# Default: 0.7
YTS_SUMMARY_TEMPERATURE=0.7

# ============================================================================
# Transcript Settings
# ============================================================================

# Comma-separated list of preferred transcript languages (ISO 639-1 codes)
# The tool will try to fetch transcripts in these languages in order
# Examples: en, es, fr, de, ja, ko, zh
# Default: en
YTS_PREFERRED_LANGUAGES=en

# ============================================================================
# Logging Configuration
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
YTS_LOG_LEVEL=INFO

# Path to log file (set to empty string to disable file logging)
# Default: ./data/app.log
YTS_LOG_FILE=./data/app.log

# ============================================================================
# CLI Output Configuration
# ============================================================================

# Output format for CLI: rich (colored, formatted) or plain (simple text)
# Default: rich
YTS_OUTPUT_FORMAT=rich

# ============================================================================
# Example Configurations for Different Scenarios
# ============================================================================

# Development (verbose logging, local Ollama):
# YTS_LOG_LEVEL=DEBUG
# YTS_OLLAMA_HOST=http://localhost:11434
# YTS_OUTPUT_FORMAT=rich

# Production (minimal logging, remote Ollama):
# YTS_LOG_LEVEL=WARNING
# YTS_OLLAMA_HOST=http://ollama-server:11434
# YTS_DATABASE_PATH=/var/lib/youtube_summarizer/summaries.db
# YTS_LOG_FILE=/var/log/youtube_summarizer/app.log

# Docker container (using volume mounts):
# YTS_DATABASE_PATH=/app/data/summaries.db
# YTS_LOG_FILE=/app/data/app.log
# YTS_OLLAMA_HOST=http://ollama:11434

# Long-form detailed summaries:
# YTS_SUMMARY_MAX_LENGTH=1500
# YTS_SUMMARY_TEMPERATURE=0.8

# Quick concise summaries:
# YTS_SUMMARY_MAX_LENGTH=200
# YTS_SUMMARY_TEMPERATURE=0.5

# Multi-language support (English, Spanish, French):
# YTS_PREFERRED_LANGUAGES=en,es,fr
